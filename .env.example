# Copy to .env (or set as GitHub repository variables) before building a release.
# These values are public: they are compiled into the extension.

# Leave unset (or false) for the free version: no license check, no network calls.
# WXT_REQUIRE_LICENSE=true

# Only used when WXT_REQUIRE_LICENSE=true:
WXT_LICENSE_API_URL=https://licenses.example.com
WXT_PAYMENT_LINK_URL=https://buy.stripe.com/your-link
WXT_PRODUCT_ID=uk-ipa

# Optional, Firefox only:
# WXT_GECKO_ID=uk-ipa@example.com
