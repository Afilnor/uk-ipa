{
  "manifest_version": 3,
  "name": "UK IPA Pop-up",
  "version": "1.1",
  "description": "Show UK IPA from Cambridge Dictionary on word highlight.",
  "permissions": ["scripting", "activeTab"],
  "host_permissions": ["https://dictionary.cambridge.org/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "css": ["popup.css"]
  }]
}